# Copy this file to:
#   ~/.config/windows-vm/windows-vm.env
# Then adjust the paths for your machine.

VM_NAME="windows10"
VM_DIR="${HOME}/VMs/${VM_NAME}"
DISK_PATH="${VM_DIR}/${VM_NAME}.qcow2"
DISK_SIZE_GB="80"

WINDOWS_ISO="${HOME}/Descargas/Win10_22H2_Spanish_x64.iso"
VIRTIO_ISO="${HOME}/Descargas/virtio-win.iso"

OVMF_CODE="/usr/share/edk2/ovmf/OVMF_CODE.secboot.fd"
OVMF_VARS_TEMPLATE="/usr/share/edk2/ovmf/OVMF_VARS.secboot.fd"
OVMF_VARS_PATH="${VM_DIR}/${VM_NAME}-OVMF_VARS.fd"

TPM_DIR="${VM_DIR}/tpm"
TPM_SOCKET="${VM_DIR}/swtpm.sock"

RAM_MB="8192"
CPU_CORES="4"

# gtk is the simplest local display. Switch to sdl if gtk gives trouble.
DISPLAY_BACKEND="gtk"

# Prefer SATA + e1000e for the first Windows install; switch to virtio later if desired.
DISK_BUS="sata"
NET_DEVICE="e1000e"
