[/]
control-center=['<Super>s']
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/','/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/','/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/spotify/','/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/spotify-next/']
home=['<Super>d']
terminal=@as []
www=['<Super>b']

[custom-keybindings/custom0]
binding='<Primary>Return'
command='gnome-terminal -- fish'
name='Fish'

[custom-keybindings/custom1]
binding='<Super>Return'
command='gnome-terminal -- fish'
name='Fish (Super)'

[custom-keybindings/spotify]
binding='XF86Favorites'
command='spotify'
name='Spotify (Fn+F12)'

[custom-keybindings/spotify-next]
binding='XF86Launch2'
command='gdbus call --session --dest org.mpris.MediaPlayer2.spotify --object-path /org/mpris/MediaPlayer2 --method org.mpris.MediaPlayer2.Player.Next'
name='Spotify: siguiente canción (Fn+F10)'
